*.ipa
*.xcuserstate
**/.xcode.env.local

# Android/IntelliJ
build/
.idea/
.gradle/
local.properties
*.iml
*.hprof
.cxx/
# No release signing key is ever committed. debug.keystore is the public one
# every Android toolchain ships, and is the only exception.
*.keystore
*.jks
!debug.keystore
.kotlin/

# node.js
node_modules/
npm-debug.log
yarn-error.log

# fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/
**/fastlane/test_output/
fastlane/play-service-account.json

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
# Gemfile.lock is committed on purpose: the release pipeline has to install the
# exact fastlane it was tested with. See docs/releasing.md.
**/Pods/
vendor/bundle/
ios/Podfile.lock
ios/*.xcworkspace/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Testing
/coverage/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Backup Files
*.orig

# Editor Files
*.swp
*~

# Source maps
*.map

# React Native Bundler
*.jsbundle
.expo/

# IDE Settings
.vscode/

# Local Environment Variables
.env
.env.local

# Android-specific directories for React Native
# Exclude generated build directories and debug/release variants
android/app/src/debug/
android/app/src/release/
android/.gradle/
android/.idea/
android/build/

# Generated by scripts/build-standalone-debug-apk.sh: the JS bundle and image
# assets a standalone debug build packages in, normally fetched from Metro
# instead. See the developer guide, site/src/content/docs/developer-guide/build-and-run.md.
android/app/src/main/assets/
android/app/src/main/res/drawable-*/
android/app/src/main/res/raw/

# Exclude the entire Android directory (if you don't want to push `android/` folder)
# android/

# iOS
# Exclude build artifacts, pods, and user-specific files
ios/Pods/
ios/build/
ios/xcuserdata/
ios/*.xcuserstate
ios/*.hmap
ios/*.ipa
ios/*.dSYM.zip
ios/*.dSYM


# Exclude other iOS-specific files
# Ignore specific files you don't need to share with other developers
**/Pods/
**/fastlane/screenshots/
**/fastlane/test_output/

#Environment files
.env.production
.env.development
.env.test

# docs folder
docs/local/*

# Local-only helper scripts
scripts/sync.sh

# Lavish review artifacts, generated locally by lavish-axi and never committed.
.lavish/
